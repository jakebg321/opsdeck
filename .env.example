# Set a long random value locally. Never commit the real token.
OPSDECK_TOKEN=
# Optional comma-separated SSH aliases from your own ~/.ssh/config.
OPSDECK_SSH_HOSTS=
# Optional dedicated directory of Markdown files shown in the Docs tab.
OPSDECK_DOCS_DIR=
# Only needed when a reverse proxy changes the scheme seen by the backend.
OPSDECK_ALLOWED_ORIGINS=
# Optional JSON snapshot written by your own Fleet collector. This can add
# remote GPUs, session summaries, and loaded-model rows without committing data.
# Example: OPSDECK_STATUS_FILE="/absolute/path/to/fleet-status.json"
OPSDECK_STATUS_FILE=
# Optional private JSON config for worker-backed model boxes. See README.md.
# Example: OPSDECK_MODEL_ADAPTERS_FILE="/absolute/path/to/model-boxes.json"
OPSDECK_MODEL_ADAPTERS_FILE=
# Optional comma-separated Ollama-compatible model endpoints for the Models tab.
# One label=url entry per endpoint; labels allow letters, digits, dot, dash, underscore.
# Example: OPSDECK_MODELS="desk=http://127.0.0.1:11434,lab=https://gpu.example.com:11434"
# Leave this and OPSDECK_MODEL_ADAPTERS_FILE empty until you configure a box.
OPSDECK_MODELS=
# Agents tab: which agent CLIs this server may run (empty disables the tab's launch controls).
# Example: OPSDECK_AGENTS="claude,codex"
OPSDECK_AGENTS=
# Agents tab: absolute CLI path per agent, with optional per-machine overrides.
# Default "agent=/abs/path" applies to every machine; "agent@machine=/abs/path"
# overrides it for one SSH host whose layout differs.
# Example: OPSDECK_AGENT_COMMANDS="claude=/usr/local/bin/claude,claude@lab=/home/op/bin/claude"
OPSDECK_AGENT_COMMANDS=
# Agents tab: optional model choices per agent (";" separates agents).
# Example: OPSDECK_AGENT_MODELS="claude=opus,sonnet;codex=gpt-5.3"
OPSDECK_AGENT_MODELS=
# Agents tab: project folders per machine. A bare path configures the server
# host ("local"); "machine=path" entries configure one SSH host each.
# Example: OPSDECK_PROJECT_ROOTS="/srv/projects,lab=/data/projects"
OPSDECK_PROJECT_ROOTS=
# Agents tab: optional JSONL transcript store(s) per machine; same syntax.
# Layout "<dir>/<agent>/*.jsonl" or flat files. Empty disables session history.
# Example: OPSDECK_AGENT_SESSIONS_DIR="/srv/agent-sessions,lab=/data/agent-sessions"
OPSDECK_AGENT_SESSIONS_DIR=
# Agents tab: optional Markdown skill catalog served from the server host.
OPSDECK_SKILLS_DIR=
# Optional spoken-briefings directory: one <id>.mp3 (or .m4a/.ogg) plus <id>.json
# sidecar (and optional <id>.txt transcript) per briefing.
OPSDECK_BRIEFINGS_DIR=
# Optional Ask-chats integration: base URL of your own compatible Ask service.
# Only http:// and https:// URLs without embedded credentials are accepted.
# The external Ask service itself is NOT included in this repository; see the
# "Ask chats" section in README.md for the required API contract.
# Example: OPSDECK_ASK_URL="http://127.0.0.1:8756"
OPSDECK_ASK_URL=
# Answering box/model id sent to your Ask service (neutral default "local").
OPSDECK_ASK_BOX=
# Optional bearer token forwarded to your Ask service as an Authorization
# header. It never appears in URLs or error output.
OPSDECK_ASK_TOKEN=
# Optional web URL of your own model console, embedded as the Models tab's
# full-console view with an external-open fallback.
# Example: OPSDECK_ASK_CONSOLE_URL="https://gpu.example.com:8443/"
OPSDECK_ASK_CONSOLE_URL=
